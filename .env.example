# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/telegram-marketplace
JWT_SECRET=your_jwt_secret_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_WEBHOOK_DOMAIN=https://your-domain.com
NODE_ENV=production

# Payment Configuration
ADMIN_TELEBIRR_NUMBER=0911000000
ADMIN_CBE_ACCOUNT=1000123456789
ADMIN_ACCOUNT_NAME=TeleGebeya Platform Escrow
PLATFORM_COMMISSION_RATE=10

# Frontend Configuration
FRONTEND_URL=https://your-frontend-domain.com

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
